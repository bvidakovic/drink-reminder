# Set a unique random code of at least 32 characters in Vercel Project Settings.
SYNC_KEY=replace-with-a-long-random-code
# On Vercel, connect a private Blob store to the project for automatic OIDC credentials.
# For local server-side development outside Vercel, use a Blob read-write token instead.
BLOB_READ_WRITE_TOKEN=replace-with-private-blob-token
